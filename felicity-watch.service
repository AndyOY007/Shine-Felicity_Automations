# systemd unit for the Felicity watchlist scheduler.
# Paths match the Pi: user translight-iot, project in ~/Shine-Felicity_Automations,
# with a virtualenv in .venv. Change the three paths below if yours differ.
#
#   sudo cp felicity-watch.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now felicity-watch
#   journalctl -u felicity-watch -f

[Unit]
Description=Felicity watchlist Telegram reports
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=translight-iot
WorkingDirectory=/home/translight-iot/Shine-Felicity_Automations
ExecStart=/home/translight-iot/Shine-Felicity_Automations/.venv/bin/python /home/translight-iot/Shine-Felicity_Automations/scheduler.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
